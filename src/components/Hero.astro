---
interface ActionLink {
  label: string;
  href: string;
}

interface HeroContent {
  tagline: string;
  subhead: string;
  installCommand: string;
  primaryCta: ActionLink;
  secondaryCta: ActionLink;
}

interface FeatureItem {
  title: string;
  description: string;
}

interface IntegrationItem {
  id: string;
  name: string;
}

interface ReleaseContent {
  version: string;
  date: string;
}

interface Props {
  brandName: string;
  hero: HeroContent;
  release: ReleaseContent;
  features: FeatureItem[];
  sources: IntegrationItem[];
  targets: IntegrationItem[];
}

const { brandName, hero, release, features, sources, targets } = Astro.props;
const releaseDate = new Intl.DateTimeFormat("en", {
  month: "short",
  day: "numeric",
  year: "numeric",
}).format(new Date(release.date));
const featureCards = features.slice(0, 3);
---

<section class="grid gap-10 pt-6 lg:grid-cols-[minmax(0,1.12fr)_minmax(320px,0.88fr)] lg:items-start">
  <div>
    <div class="inline-flex items-center gap-3 rounded-full border border-border/80 bg-surface/60 px-4 py-2 text-sm font-semibold tracking-[0.2em] text-success uppercase shadow-[0_18px_40px_rgba(6,12,24,0.2)]">
      <span class="rounded-full bg-success/15 px-2 py-1 text-[0.65rem] text-success">OSS</span>
      <span>{brandName}</span>
    </div>

    <div class="mt-8 max-w-4xl">
      <p class="font-mono text-sm uppercase tracking-[0.34em] text-accent">Universal handoff infrastructure</p>
      <h1 class="mt-5 text-5xl font-black tracking-[-0.06em] text-balance text-text sm:text-6xl lg:text-7xl">
        {hero.tagline}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-muted sm:text-xl">
        {hero.subhead}
      </p>
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a
        class="inline-flex items-center justify-center rounded-full bg-accent px-6 py-3 text-sm font-bold text-white shadow-[0_14px_34px_rgba(233,69,96,0.34)] hover:-translate-y-0.5 hover:bg-accent/92"
        href={hero.primaryCta.href}
        rel="noreferrer"
        target="_blank"
      >
        {hero.primaryCta.label}
      </a>
      <a
        class="inline-flex items-center justify-center rounded-full border border-border/90 bg-surface/60 px-6 py-3 text-sm font-semibold text-text hover:border-accent/80 hover:text-white"
        href={hero.secondaryCta.href}
        rel="noreferrer"
        target="_blank"
      >
        {hero.secondaryCta.label}
      </a>
      <div class="inline-flex items-center gap-2 rounded-full border border-border/80 bg-ink/40 px-4 py-2 text-sm text-muted">
        <span class="font-semibold text-text">v{release.version}</span>
        <span aria-hidden="true">•</span>
        <span>{releaseDate}</span>
      </div>
    </div>

    <div class="glass-panel mt-10 overflow-hidden">
      <div class="flex flex-col gap-4 px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-muted">Install in one command</p>
          <code class="mt-3 block overflow-x-auto rounded-2xl bg-ink/80 px-4 py-4 text-sm text-success sm:text-base">
            {hero.installCommand}
          </code>
        </div>
        <div class="sm:text-right">
          <button
            aria-label={`Copy install command: ${hero.installCommand}`}
            class="inline-flex min-w-32 items-center justify-center rounded-full border border-success/40 bg-success/12 px-5 py-3 text-sm font-semibold text-success hover:border-success/70 hover:bg-success/20"
            data-copy-command={hero.installCommand}
            type="button"
          >
            Copy command
          </button>
          <p class="mt-3 text-sm text-muted" data-copy-status role="status" aria-live="polite">
            Ready for pip install.
          </p>
        </div>
      </div>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {
        featureCards.map((feature) => (
          <article class="glass-panel rounded-[24px] px-5 py-5">
            <h2 class="text-lg font-bold tracking-[-0.03em] text-text">{feature.title}</h2>
            <p class="mt-3 text-sm leading-7 text-muted">{feature.description}</p>
          </article>
        ))
      }
    </div>
  </div>

  <aside class="glass-panel relative overflow-hidden rounded-[36px] p-6 sm:p-8">
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-success/60 to-transparent"></div>
    <div class="flex items-center justify-between gap-4">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-success">Source to target</p>
        <h2 class="mt-3 text-2xl font-black tracking-[-0.04em] text-text">One context layer, many agent outputs.</h2>
      </div>
      <div class="rounded-full border border-border/80 bg-ink/60 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-muted">
        Static site
      </div>
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-[1fr_auto_1fr] md:items-start">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-muted">Sources</p>
        <div class="mt-4 flex flex-wrap gap-3">
          {
            sources.map((source) => (
              <span class="inline-flex rounded-full border border-border/80 bg-ink/55 px-3 py-2 text-sm font-medium text-text">
                {source.name}
              </span>
            ))
          }
        </div>
      </div>

      <div class="hidden items-center justify-center md:flex">
        <div class="rounded-full border border-accent/60 bg-accent/10 px-4 py-2 font-mono text-sm text-accent">
          normalize
        </div>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-muted">Targets</p>
        <div class="mt-4 flex flex-wrap gap-3">
          {
            targets.map((target) => (
              <span class="inline-flex rounded-full border border-border/80 bg-surface/80 px-3 py-2 text-sm font-medium text-text">
                {target.name}
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mt-8 grid gap-4 rounded-[28px] border border-border/70 bg-ink/55 p-5 sm:grid-cols-2">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-muted">Universal layer</p>
        <p class="mt-3 text-sm leading-7 text-muted">
          `.handover/` keeps the project brief, plan, decisions, standards, and prompts portable across agents.
        </p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-muted">Agent fit</p>
        <p class="mt-3 text-sm leading-7 text-muted">
          Target adapters render that same context into `CLAUDE.md`, `AGENTS.md`, Copilot instructions, Goose JSON, and more.
        </p>
      </div>
    </div>
  </aside>
</section>

<script>
  const buttons = document.querySelectorAll("[data-copy-command]");

  buttons.forEach((button) => {
    if (!(button instanceof HTMLButtonElement) || button.dataset.bound === "true") {
      return;
    }

    button.dataset.bound = "true";

    button.addEventListener("click", async () => {
      const command = button.dataset.copyCommand ?? "";
      const status = button.parentElement?.querySelector("[data-copy-status]");

      try {
        await navigator.clipboard.writeText(command);

        if (status instanceof HTMLElement) {
          status.textContent = "Copied to clipboard.";
        }

        button.textContent = "Copied";
      } catch {
        if (status instanceof HTMLElement) {
          status.textContent = "Clipboard access failed. Copy it manually.";
        }

        button.textContent = "Copy manually";
      }

      window.setTimeout(() => {
        button.textContent = "Copy command";

        if (status instanceof HTMLElement) {
          status.textContent = "Ready for pip install.";
        }
      }, 1800);
    });
  });
</script>
