---
interface ArtifactEntry {
  path: string;
  description: string;
}

interface Layer {
  id: string;
  name: string;
  summary: string;
  entries: ArtifactEntry[];
}

interface Content {
  eyebrow: string;
  title: string;
  description: string;
}

interface Props {
  content: Content;
  layers: Layer[];
}

const { content, layers } = Astro.props;
---

<section class="section-shell">
  <span class="eyebrow">{content.eyebrow}</span>
  <h2 class="section-title">{content.title}</h2>
  <p class="section-copy">{content.description}</p>

  <div class="mt-10 grid gap-6 xl:grid-cols-2">
    {
      layers.map((layer) => (
        <article class="glass-panel rounded-[32px] p-6">
          <div class="flex items-center justify-between gap-4">
            <h3 class="text-2xl font-black tracking-[-0.04em] text-text">{layer.name}</h3>
            <span class="rounded-full border border-border/80 bg-ink/45 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-muted">
              {layer.entries.length} entries
            </span>
          </div>
          <p class="mt-4 text-sm leading-7 text-muted">{layer.summary}</p>

          <div class="mt-6 space-y-4">
            {
              layer.entries.map((entry) => (
                <article class="rounded-[24px] border border-border/80 bg-ink/45 px-5 py-5">
                  <code class="text-sm text-success">{entry.path}</code>
                  <p class="mt-3 text-sm leading-7 text-muted">{entry.description}</p>
                </article>
              ))
            }
          </div>
        </article>
      ))
    }
  </div>
</section>
