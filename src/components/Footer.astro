---
interface LinkItem {
  label: string;
  href: string;
}

interface FooterContent {
  blurb: string;
  links: LinkItem[];
}

interface Props {
  brandName: string;
  footer: FooterContent;
}

const { brandName, footer } = Astro.props;
---

<footer class="section-shell pb-6">
  <div class="glass-panel rounded-[32px] px-6 py-6">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <p class="font-mono text-xs uppercase tracking-[0.26em] text-success">{brandName}</p>
        <p class="mt-4 text-base leading-8 text-muted">{footer.blurb}</p>
      </div>

      <nav aria-label="Footer links" class="flex flex-wrap gap-3">
        {
          footer.links.map((link) => (
            <a
              class="inline-flex items-center rounded-full border border-border/80 bg-ink/45 px-4 py-2 text-sm font-semibold text-text hover:border-accent/70 hover:text-white"
              href={link.href}
              rel="noreferrer"
              target="_blank"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>
